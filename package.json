{
  "name": "ssg-base",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build && bun scripts/check-build.ts",
    "preview": "vite preview --outDir build/client",
    "icons": "bun scripts/icons.ts",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "typecheck": "react-router typegen && tsc",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@react-router/node": "^8.5.0",
    "isbot": "^5.2.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@react-router/dev": "^8.5.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.74.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
